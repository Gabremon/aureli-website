# Database Configuration
# Copy this file to .env and it will be used by docker-compose
DB_HOST=localhost
DB_PORT=5433
DB_NAME=aureli_db
DB_USER=aureli_gabe_user
DB_PASSWORD=aureli_password

# Note: Port 5433 is used because you have a local PostgreSQL running on port 5432.
# If you stop the local PostgreSQL, you can change this to 5432.

# IMPORTANT: 
# - Use underscores in usernames, NOT hyphens (hyphens cause connection issues)
# - DB_NAME should be "aureli_db" (with underscore, not hyphen)
# - Usernames are case-insensitive in PostgreSQL (will be converted to lowercase)

# Server Configuration
SERVER_PORT=3001
CLIENT_URL=http://localhost:5173

# Optional: Full connection string (can be used by your application)
# DATABASE_URL=postgresql://aureli_user:aureli_password@localhost:5432/aureli_db

